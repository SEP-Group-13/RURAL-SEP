# Local Docker development only. Use synthetic/public data.
POSTGRES_DB=rural_dev
POSTGRES_USER=rural_dev
POSTGRES_PASSWORD=local-development-only
DATA_SERVICE_PORT=3000

# Used by Express when running outside Docker. Compose supplies its own values.
HOST=127.0.0.1
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=rural_dev
PGUSER=rural_dev
PGPASSWORD=local-development-only
